# Walstream configuration
WALSTREAM_S3_BUCKET=my-walstream-bucket
WALSTREAM_S3_REGION=eu-north-1
# WALSTREAM_S3_ENDPOINT=https://s3.example.internal
# WALSTREAM_S3_ALLOW_HTTP=false
WALSTREAM_S3_PREFIX=walstream
WALSTREAM_CLUSTER_ID=development
WALSTREAM_LISTEN=0.0.0.0:9092
WALSTREAM_ADVERTISED_HOST=127.0.0.1
# WALSTREAM_ADVERTISED_PORT=9092
# WALSTREAM_MAX_FRAME_BYTES=16777216
# WALSTREAM_DEFAULT_TOPIC_PARTITIONS=1

# Standard AWS credential-chain inputs; do not commit real values.
AWS_ACCESS_KEY_ID=example
AWS_SECRET_ACCESS_KEY=example-secret
